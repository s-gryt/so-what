@@ -0,0 +1,11 @@
+#!/usr/bin/env bash
+set -euo pipefail
+for f in "$@"; do
+  case "$f" in
+    *.py) pattern='^[[:space:]]*#' ;;
+    *.js|*.ts) pattern='^[[:space:]]*//' ;;
+    *.md|*.yaml|*.yml) continue ;;
+    *) echo "unknown file type: $f"; exit 1 ;;
+  esac
+  if grep -Eq "$pattern" "$f"; then echo "comment found in $f"; exit 1; fi
+done
