+#!/usr/bin/env bash
+set -euo pipefail
+for n in ENGINEERING DOMAIN ARCHITECTURE VALIDATION; do
+  [ -f "docs/$n.md" ] || { echo "missing docs/$n.md"; exit 1; }
+done
